<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="InvRoot" style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 0; width: auto; height: auto; background-color: rgba(11, 13, 16, 0); justify-content: center; align-items: center;">
        <ui:VisualElement name="Dim" style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 0; -unity-background-image-tint-color: rgba(255, 255, 255, 0.22); background-color: rgba(11, 13, 16, 0.78); width: 1920px; height: 1080px;" />
        <ui:VisualElement name="InvPanel" style="flex-grow: 1; position: relative; width: 980px; height: 620px; top: auto; left: auto; right: auto; bottom: auto; background-color: rgba(18, 20, 23, 0.78); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; flex-direction: row; border-left-color: rgb(60, 60, 60); border-right-color: rgb(60, 60, 60); border-top-color: rgb(60, 60, 60); border-bottom-color: rgb(60, 60, 60);">
            <ui:VisualElement name="Sidebar" style="flex-grow: 1; width: 56px; background-color: rgba(0, 0, 0, 0.1); -unity-background-image-tint-color: rgba(255, 255, 255, 0.1); border-right-width: 1px; border-right-color: rgb(43, 49, 55); align-items: center; margin-top: 0; padding-top: 8px;" />
            <ui:VisualElement name="Content" style="flex-grow: 1; padding-left: 12px; padding-right: 12px;">
                <ui:VisualElement name="Header" style="flex-grow: 1; height: 28px; flex-direction: row; justify-content: space-between; margin-bottom: 8px;">
                    <ui:Label text="INVENTORY" name="INVENTORY" style="color: rgb(231, 235, 239); -unity-font-style: bold; font-size: 16px;" />
                    <ui:Label text="Label" name="WeightLabel" style="background-color: rgba(0, 0, 0, 0); color: rgb(147, 160, 174); -unity-text-outline-color: rgba(0, 0, 0, 0.14); padding-right: 6px; padding-left: 6px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;" />
                </ui:VisualElement>
                <ui:VisualElement name="GridRoot" style="flex-grow: 1; background-color: rgb(21, 24, 27); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(43, 49, 55); border-right-color: rgb(43, 49, 55); border-top-color: rgb(43, 49, 55); border-bottom-color: rgb(43, 49, 55); width: auto; height: auto;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
